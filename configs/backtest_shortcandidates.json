{
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 9,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "dry_run_wallet": 100000,
  "tradable_balance_ratio": 1.0,
  "fees": { "fee": 0.001 },
  "timeframe": "2h",
  "datadir": "data",
  "strategy_path": "/opt/freqtrade/user_data/strategies",
  "pairlists": [{"method": "StaticPairList"}],
  "exchange": {
    "name": "binance",
    "pair_whitelist": [
      "BTC/USDT:USDT","ETH/USDT:USDT","SOL/USDT:USDT","XRP/USDT:USDT","ADA/USDT:USDT",
      "DOGE/USDT:USDT","DOT/USDT:USDT","AVAX/USDT:USDT","LINK/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "process_only_new_candles": true,
  "use_exit_signal": true,
  "exit_profit_only": false,
  "entry_pricing": {"price_side":"same","use_order_book":true,"order_book_top":1,"check_depth_of_market":{"enabled":false,"bids_to_ask_delta":1}},
  "exit_pricing": {"price_side":"same","use_order_book":true,"order_book_top":1},
  "order_types": {"entry":"limit","exit":"limit","stoploss":"limit","stoploss_on_exchange":false}
}
